# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# YAML files (GitHub Actions, config)
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Markdown files - preserve trailing spaces for line breaks
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Shell scripts
[*.sh]
end_of_line = lf

# Makefiles require tabs
[Makefile]
indent_style = tab

# HTML files
[*.{html,htm}]
indent_size = 2

# CSS/SCSS/SASS/LESS files
[*.{css,scss,sass,less}]
indent_size = 2

# JavaScript/TypeScript files
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# Svelte files
[*.svelte]
indent_size = 2

# XML files
[*.{xml,xsl,xslt}]
indent_size = 2

# Config files
[*.{conf,config,in,ini,gitconfig}]
indent_size = 2

# Docker files
[Dockerfile*]
indent_size = 2

# TypeScript definition files
[*.d.ts]
indent_size = 2

# Vitest test files
[*.test.{ts,js}]
indent_size = 2

# Build configuration files
[{vite.config.ts,svelte.config.js,eslint.config.js,tsconfig.json}]
indent_size = 2
